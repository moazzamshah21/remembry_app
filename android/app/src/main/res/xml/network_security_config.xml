<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: Disallow cleartext traffic for security compliance -->
    <!-- This is required for Google Play policy compliance -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust preinstalled CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow cleartext only for localhost and Android emulator (development only) -->
    <!-- Remove or restrict these in production if not needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Android emulator host machine -->
    </domain-config>
</network-security-config>